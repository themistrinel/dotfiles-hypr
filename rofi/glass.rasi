/* ═══════════════════════════════════════════════════════════════
   Glass Rofi (light) — generated by glass-theme.sh
   Translucent glass surface with wallpaper-derived colors
   ═══════════════════════════════════════════════════════════════ */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    drun-display-format: "{name}";
    font: "JetBrains Mono Nerd Font 10";
}

* {
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
    background-color: transparent;
    text-color: #1e1f26;
}

window {
    transparency: "real";
    background-color: rgba(240, 245, 247, 0.72);
    border: 1px;
    border-color: rgba(0, 0, 0, 0.15);
    border-radius: 14px;
    width: 620px;
    padding: 12px;
}

mainbox {
    background-color: transparent;
    padding: 0;
    spacing: 10px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: rgba(0, 0, 0, 0.04);
    border: 1px;
    border-color: rgba(0, 0, 0, 0.10);
    border-radius: 10px;
    padding: 8px 12px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: rgba(42, 129, 171, 0.95);
}

entry {
    text-color: #0f1015;
    placeholder: "Search...";
    placeholder-color: rgba(85, 90, 105, 0.55);
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    spacing: 4px;
    padding: 6px 0 0 0;
}

element {
    background-color: transparent;
    text-color: #1e1f26;
    border-radius: 8px;
    padding: 8px 12px;
    spacing: 12px;
}

element-icon {
    size: 24px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element normal.normal {
    background-color: transparent;
    text-color: #1e1f26;
}

element alternate.normal {
    background-color: transparent;
    text-color: #1e1f26;
}

element selected.normal {
    background-color: rgba(42, 129, 171, 0.32);
    text-color: #090a0f;
    border: 1px;
    border-color: rgba(0, 0, 0, 0.16);
    border-radius: 8px;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: #090a0f;
}

element selected.active {
    background-color: rgba(42, 129, 171, 0.55);
    text-color: #090a0f;
}
