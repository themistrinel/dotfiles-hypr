/* ═══════════════════════════════════════════════════════════════
   Pywal Rofi — Dynamic theme using Pywal colors
   Supports both Light and Dark modes automatically
   ═══════════════════════════════════════════════════════════════ */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    drun-display-format: "{name}";
    font: "JetBrains Mono Nerd Font 10";
}

@import "~/.cache/wal/colors-rofi.rasi"

* {
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
    background-color: transparent;
    text-color: @foreground;
}

window {
    transparency: "real";
    background-color: @background;
    border: 1px;
    border-color: @selected-border;
    border-radius: 12px;
    width: 600px;
    padding: 0;
}

mainbox {
    background-color: transparent;
    padding: 10px;
}

inputbar {
    background-color: @background-alt;
    border: 1px;
    border-color: @selected-border;
    border-radius: 8px;
    padding: 10px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @foreground;
}

entry {
    text-color: @foreground;
    placeholder: "Search...";
    placeholder-color: @color8;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    spacing: 3px;
    padding: 8px 0 0 0;
}

element {
    background-color: transparent;
    text-color: @foreground;
    border-radius: 6px;
    padding: 8px 10px;
    spacing: 10px;
}

element-icon {
    size: 24px;
    padding: 0 10px 0 0;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @selected;
    text-color: @foreground;
    border: 1px;
    border-color: @selected-border;
    border-radius: 6px;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @foreground;
}

element selected.active {
    background-color: @selected;
    text-color: @foreground;
}
